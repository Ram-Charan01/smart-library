# Defaults to a local MongoDB process with persistent files in backend/.library-data.
# MONGODB_URI=mongodb://127.0.0.1:27017
# MONGODB_DB=smart_library
# PORT=3000
# HOST=127.0.0.1

# Applies when creating accounts in a fresh database.
# ADMIN_PASSWORD=admin123
# STUDENT_PASSWORD=user123
# SECURE_COOKIE=true
